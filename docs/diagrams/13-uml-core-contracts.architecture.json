  "cards": [
    {
      "dot": "cyan",
      "title": "One place for shared types",
      "items": [
        "If a type belongs to more than one package, it belongs in @husk-ai/core",
        "core imports nothing from the workspace, so the graph stays acyclic"
      ]
    },
    {
      "dot": "emerald",
      "title": "Computer is narrow and complete",
      "items": [
        "exec, files, ports, lifecycle — plus optional snapshot/restore you must feature-detect",
        "So an agent never learns which provider it is running on"
      ]
    },
    {
      "dot": "rose",
      "title": "Approver fails closed",
      "items": [
        "Returning false, throwing, and not being supplied at all must all deny",
        "A headless server running an ask-mode husk denies rather than behaving as auto"
      ]
    }
  ]
