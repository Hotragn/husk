  "cards": [
    {
      "dot": "cyan",
      "title": "The MCP process is passive",
      "items": [
        "It never starts a server — it is a child of someone's editor",
        "It looks for a live console and hands over a deep link, or the one command that creates one"
      ]
    },
    {
      "dot": "emerald",
      "title": "One machine, three views",
      "items": [
        "The console's terminal, file browser and web browser all point at the same computer",
        "Because the browser runs inside it, the page the human sees is the page the agent got"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing listens by default",
      "items": [
        "husk serve binds loopback and refuses a non-loopback address without HUSK_TOKEN",
        "No credential storage: keys are read from the environment, never written to ~/.husk"
      ]
    }
  ]
