    {
      "dot": "cyan",
      "title": "There is no database",
      "items": [
        "State is JSON files under ~/.husk, written with write-then-rename",
        "No native modules, so a Windows npm install stays clean"
      ]
    },
    {
      "dot": "emerald",
      "title": "There is no control plane",
      "items": [
        "No account, no signup, no hosted tier in the path",
        "The only outbound calls are the model provider you configured and an image registry"
      ]
    },
