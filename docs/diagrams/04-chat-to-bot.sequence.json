  "cards": [
    {
      "dot": "cyan",
      "title": "Importers normalise, they do not interpret",
      "items": [
        "Claude Code JSONL, ChatGPT exports, Cursor, Gemini and markdown become one Transcript",
        "Branched threads are rebuilt by walking parentUuid from the last leaf — not every dead end"
      ]
    },
    {
      "dot": "emerald",
      "title": "The heuristic path has to be good",
      "items": [
        "It is the mode that runs with no API key at all",
        "It mines recurring instructions, prefers exemplars the user did not correct, and reports honest confidence"
      ]
    },
    {
      "dot": "rose",
      "title": "The husk.yaml is the product",
      "items": [
        "Optimised for human review: deliberate key order, block scalars, provenance header",
        "Secrets are stripped before the file is written, not after"
      ]
    }
  ]
