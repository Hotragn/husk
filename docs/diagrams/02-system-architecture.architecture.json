  "cards": [
    {
      "dot": "cyan",
      "title": "Four entry points",
      "items": [
        "@husk-ai/mcp — stdio only; streamable HTTP is specced, not built",
        "@husk-ai/cli, @husk-ai/server (loopback), @husk-ai/adapters"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dependencies run downhill",
      "items": [
        "All 10 packages import @husk-ai/core; core imports nothing from the workspace",
        "Nothing imports @husk-ai/cli"
      ]
    },
    {
      "dot": "amber",
      "title": "Lazy edges are real edges",
      "items": [
        "cli → server and cli → mcp are dynamic imports, not package deps",
        "server → agent likewise, so the server starts without the agent built"
      ]
    }
  ]
