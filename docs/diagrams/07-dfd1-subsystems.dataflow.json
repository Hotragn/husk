  "cards": [
    {
      "dot": "cyan",
      "title": "Five subsystems, one contract",
      "items": [
        "Entry, agent loop, sessions, model router, computer manager",
        "All five speak only the types in @husk-ai/core"
      ]
    },
    {
      "dot": "emerald",
      "title": "The agent never learns where it is",
      "items": [
        "Computer is a narrow, complete interface; translation lives in the provider",
        "So a husk written against Docker runs unchanged on ssh or local"
      ]
    },
    {
      "dot": "rose",
      "title": "Falling back is announced",
      "items": [
        "A 429, a dead Ollama or an expired key walks fallbackModels with jittered backoff",
        "It emits a warning event — silently answering with a weaker model is worse than failing"
      ]
    }
