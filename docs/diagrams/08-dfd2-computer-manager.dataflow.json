  "cards": [
    {
      "dot": "cyan",
      "title": "One conversation, one machine",
      "items": [
        "ensure(key) maps a stable key to a machine, so /work survives across tool calls",
        "Concurrent callers with the same key share one in-flight create"
      ]
    },
    {
      "dot": "emerald",
      "title": "Probes are cached because agents are chatty",
      "items": [
        "docker version on a cold daemon costs ~800ms",
        "An agent may create four machines in a row"
      ]
    },
    {
      "dot": "rose",
      "title": "Never a silent downgrade",
      "items": [
        "An explicit --provider that is unavailable is an error, not a fallback to local",
        "Substituting weaker isolation is how a surprise becomes an incident"
      ]
    }
  ]
