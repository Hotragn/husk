{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting.

       `strict` is on because the brief says no `any` at the SDK boundary, and
       the only way to hold that line is to let the compiler refuse the
       shortcuts. `exactOptionalPropertyTypes` earns its keep here in
       particular: `@husk-ai/core` distinguishes an absent optional field from one
       explicitly set to `undefined`, and so does the wire format. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The app build is a browser bundle; the tests are not part of it. They pull
     vitest, and through it Node's `process` types, which collide with the
     browser shim in `src/shims/process.ts` — an upstream mismatch this config
     has no business adopting. Vitest transforms and runs them either way. */
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
