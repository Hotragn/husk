# husk full flavor
#
# Python, Node and a C toolchain in one machine. Roughly 3x the base image, so it is
# never the default -- but an agent asked to "build and test this repo" needs it, and
# discovering that mid-run costs more than the pull did.
ARG HUSK_VERSION=0.1.0
FROM ghcr.io/husk-sh/husk-python:${HUSK_VERSION} AS base

LABEL org.opencontainers.image.title="husk-full" \
      husk.flavor="full"

USER root
ARG NODE_MAJOR=22
ENV HUSK_FLAVOR=full \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        build-essential \
        pkg-config \
        libssl-dev \
        sqlite3 \
        make \
        cmake \
        vim \
        tmux \
        rsync \
        ffmpeg \
        imagemagick \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

RUN mkdir -p /home/husk/.npm-global && chown -R husk:husk /home/husk/.npm-global
ENV NPM_CONFIG_PREFIX=/home/husk/.npm-global \
    PATH=/home/husk/.npm-global/bin:$PATH

USER husk
WORKDIR /work
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/husk-entrypoint"]
CMD ["idle"]
