{
  "name": "@husk/sdk",
  "version": "0.1.0",
  "description": "Typed, dependency-free client for the Husk control plane.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude src/contract.test.ts"
  },
  "dependencies": {
    "@husk/core": "0.1.0"
  }
}
