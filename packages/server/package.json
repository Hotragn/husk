    "@husk-ai/browser": "0.1.1",
    "@husk-ai/core": "0.1.1",
    "@husk-ai/models": "0.1.1",
    "@husk-ai/runtime": "0.1.1",
    "@husk-ai/sessions": "0.1.1",
    "fastify": "^5.12.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
