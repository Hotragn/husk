{
  "name": "@husk-ai/server",
  "version": "0.2.0",
  "description": "Husk control plane (REST + SSE + WS) and bot host.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hotragn/husk.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Hotragn/husk/tree/main/packages/server#readme",
  "bugs": "https://github.com/Hotragn/husk/issues",
  "keywords": [
    "husk",
    "ai-agent",
    "control-plane",
    "api-server"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace-viewer": {
      "types": "./dist/workspace-viewer.d.ts",
      "import": "./dist/workspace-viewer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@husk-ai/adapters": "0.2.0",
    "@husk-ai/browser": "0.2.0",
    "@husk-ai/core": "0.2.0",
    "@husk-ai/console-assets": "0.2.0",
    "@husk-ai/workspaces": "0.2.0",
    "@husk-ai/models": "0.2.0",
    "@husk-ai/runtime": "0.2.0",
    "@husk-ai/sessions": "0.2.0",
    "fastify": "^5.12.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "^5.0.1"
  }
}
