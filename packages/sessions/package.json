{
  "name": "@husk-ai/sessions",
  "version": "0.1.0",
  "description": "Transcript importers and the distiller that turns a chat into a husk.yaml.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@husk-ai/core": "0.1.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  }
}
