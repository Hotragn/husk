{
  "name": "@husk-ai/browser",
  "version": "0.1.0",
  "description": "A real Chromium inside a Husk computer, driven over CDP.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/driver.py"
  ],
  "scripts": {
    "build": "node scripts/embed-driver.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "embed-driver": "node scripts/embed-driver.mjs"
  },
  "dependencies": {
    "@husk-ai/core": "0.1.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
