{
  "name": "@husk-ai/cli",
  "version": "0.1.0",
  "description": "The husk command line: give your agent a computer, and turn a chat into a bot.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "husk": "./bin/husk"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@husk-ai/agent": "0.1.0",
    "@husk-ai/core": "0.1.0",
    "@husk-ai/models": "0.1.0",
    "@husk-ai/runtime": "0.1.0",
    "@husk-ai/sessions": "0.1.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@husk-ai/mcp": "0.1.0",
    "@husk-ai/sdk": "0.1.0",
    "@husk-ai/server": "0.1.0"
  }
}
