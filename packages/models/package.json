{
  "name": "@husk-ai/models",
  "version": "0.1.1",
  "description": "One model surface for Husk: Anthropic, OpenAI, Gemini, Ollama and every OpenAI-compatible gateway, with routing, fallback and cost accounting. No SDKs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hotragn/husk.git",
    "directory": "packages/models"
  },
  "homepage": "https://github.com/Hotragn/husk/tree/main/packages/models#readme",
  "bugs": "https://github.com/Hotragn/husk/issues",
  "keywords": ["husk", "ai-agent", "llm", "anthropic", "openai", "ollama", "groq"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@husk-ai/core": "0.1.1"
  }
}
