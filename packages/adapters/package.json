{
  "name": "@husk-ai/adapters",
  "version": "0.1.1",
  "description": "Chat front ends for Husk: Discord, Slack, Telegram, generic webhook.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hotragn/husk.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/Hotragn/husk/tree/main/packages/adapters#readme",
  "bugs": "https://github.com/Hotragn/husk/issues",
  "keywords": ["husk", "ai-agent", "discord-bot", "slack-bot", "telegram-bot", "webhook"],
  "engines": {
    "node": ">=20.10"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@husk-ai/core": "0.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "vitest": "^2.1.9"
  }
}
