      "shadowRgb": "37, 32, 25",
      "hairlineLight": "rgba(255, 255, 255, 0.90)"
    }
  },
  "typography": {
    "families": {
      "display": {
        "name": "Bricolage Grotesque",
        "designer": "Mathieu Triay",
        "license": "SIL Open Font License 1.1",
        "source": "Google Fonts",
        "variable": true,
        "axes": {
          "opsz": [
            12,
            96
          ],
          "wdth": [
            75,
            100
          ],
          "wght": [
            200,
            800
          ],
          "GRAD": [
            -50,
            100
          ]
        },
        "stack": "\"Bricolage Grotesque\", \"Archivo\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "why": "A grotesque with the tool marks left in: flat-sided bowls, a chopped g, uneven joins. The only place Husk allows visible personality, and it carries real optical machinery."
      },
      "ui": {
        "name": "Instrument Sans",
        "designer": "Rodrigo Fuenzalida, Jordan Egstad",
        "license": "SIL Open Font License 1.1",
        "source": "Google Fonts",
        "variable": true,
        "axes": {
          "wght": [
            400,
            700
          ],
          "wdth": [
            75,
            100
          ]
        },
        "stack": "\"Instrument Sans\", \"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "why": "High x-height, open apertures, unambiguous 1/l/I. No weight below 400 exists on the variable axis; do not request 300."
      },
      "mono": {
        "name": "JetBrains Mono",
        "designer": "Philipp Nurullin, Konstantin Bulenkov",
        "license": "SIL Open Font License 1.1",
        "source": "Google Fonts",
        "variable": true,
        "axes": {
          "wght": [
            100,
            800
          ]
        },
        "slashedZero": "Default. No OpenType feature required. Menlo, Consolas and DejaVu Sans Mono in the fallback stack also disambiguate zero, so it survives a failed font load.",
        "ligatures": "Live in `calt`, on by default in browsers. Disable for terminal output so != does not fuse into one glyph.",
        "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"DejaVu Sans Mono\", monospace",
        "why": "Monospace is semantic here, not decorative: if a machine said it, it is monospaced."
      }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "display": 620
    },
    "scale": {
      "ratio": 1.2,
      "ratioName": "minor third (6:5)",
      "base": "1rem",
      "rounding": "none - rounding to whole pixels breaks the ratio and every engine rasterises fractional sizes correctly",
      "steps": {
        "2xs": {
          "rem": "0.5787rem",
          "px": 9.26,
          "exponent": -3,
          "use": "legal and meta only, never a full sentence"
        },
        "xs": {
          "rem": "0.6944rem",
          "px": 11.11,
          "exponent": -2,
          "use": "table labels, badges, axis ticks"
        },
        "sm": {
          "rem": "0.8333rem",
          "px": 13.33,
          "exponent": -1,
          "use": "captions, help text, dense tables"
        },
        "md": {
          "rem": "1rem",
          "px": 16,
          "exponent": 0,
          "use": "body, the default"
        },
        "lg": {
          "rem": "1.2rem",
          "px": 19.2,
          "exponent": 1,
          "use": "lead paragraphs, h4"
        },
        "xl": {
          "rem": "1.44rem",
          "px": 23.04,
          "exponent": 2,
          "use": "h3"
        },
        "2xl": {
          "rem": "1.728rem",
          "px": 27.65,
          "exponent": 3,
          "use": "h2"
        },
        "3xl": {
          "rem": "2.0736rem",
          "px": 33.18,
          "exponent": 4,
          "use": "h1 on mobile"
        },
        "4xl": {
          "rem": "2.4883rem",
          "px": 39.81,
          "exponent": 5,
          "use": "h1"
        },
        "5xl": {
          "rem": "2.986rem",
          "px": 47.78,
          "exponent": 6,
          "use": "section display"
        },
        "6xl": {
          "rem": "3.5832rem",
          "px": 57.33,
          "exponent": 7,
          "use": "hero, small viewports"
        },
        "7xl": {
          "rem": "4.2998rem",
          "px": 68.8,
          "exponent": 8,
          "use": "hero"
        },
        "8xl": {
          "rem": "5.1598rem",
          "px": 82.56,
          "exponent": 9,
          "use": "hero, wide viewports only"
        }
      },
      "hero": "clamp(2.4883rem, 1.4rem + 5.2vw, 5.1598rem)"
    },
    "lineHeight": {
      "flat": 1,
      "tight": 1.04,
      "snug": 1.14,
      "heading": 1.26,
      "normal": 1.5,
      "relaxed": 1.62,
      "code": 1.55
    },
    "letterSpacing": {
      "2xs": "0.028em",
      "xs": "0.018em",
      "sm": "0.008em",
      "md": "0",
      "lg": "-0.005em",
      "xl": "-0.009em",
      "2xl": "-0.013em",
      "3xl": "-0.017em",
      "4xl": "-0.020em",
      "5xl": "-0.023em",
      "6xl": "-0.026em",
      "7xl": "-0.029em",
      "8xl": "-0.032em",
      "caps": "0.075em",
      "mono": "0"
    },
    "opticalAdjustments": {
      "note": "Bricolage Grotesque's opsz axis must be set to the RENDERED pixel size. The browser will not infer it through a clamp(). GRAD compensates for the optical bolding of light-on-dark text and is metric-neutral, so line breaks do not move between themes.",
      "variationSettings": {
        "dark": {
          "hero": "\"opsz\" 83, \"wdth\" 92, \"wght\" 620, \"GRAD\" -30",
          "h1": "\"opsz\" 40, \"wdth\" 100, \"wght\" 620, \"GRAD\" -30",
          "h2": "\"opsz\" 28, \"wdth\" 100, \"wght\" 600, \"GRAD\" -20",
          "h3": "\"opsz\" 23, \"wdth\" 100, \"wght\" 600, \"GRAD\" -10"
        },
        "light": {
          "hero": "\"opsz\" 83, \"wdth\" 92, \"wght\" 620, \"GRAD\" 0",
          "h1": "\"opsz\" 40, \"wdth\" 100, \"wght\" 620, \"GRAD\" 0",
          "h2": "\"opsz\" 28, \"wdth\" 100, \"wght\" 600, \"GRAD\" 0",
          "h3": "\"opsz\" 23, \"wdth\" 100, \"wght\" 600, \"GRAD\" 0"
        }
      },
      "minWidth": 90
    },
    "features": {
      "ui": "\"kern\" 1, \"liga\" 1, \"calt\" 1",
      "tabular": "\"kern\" 1, \"tnum\" 1, \"lnum\" 1",
      "mono": "\"kern\" 0, \"liga\" 1, \"calt\" 1",
      "monoTerminal": "\"kern\" 0, \"liga\" 0, \"calt\" 0"
    },
    "measure": {
      "prose": "68ch",
      "lead": "48ch",
      "narrow": "34ch"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem",
    "40": "10rem",
    "48": "12rem",
    "px": "1px",
    "0-5": "0.125rem",
    "1-5": "0.375rem",
    "section": "6rem",
    "sectionTight": "4rem",
    "sectionWide": "10rem"
  },
  "radius": {
    "none": "0",
    "xs": "2px",
    "sm": "3px",
    "md": "5px",
    "lg": "8px",
    "xl": "12px",
    "full": "999px",
    "note": "Deliberately tight. The mark is faceted; the UI is chiselled. Nothing above lg exists except pills and avatars."
  },
  "borderWidth": {
    "hairline": "1px",
    "thin": "1.5px",
    "thick": "2px",
    "heavy": "3px"
  },
  "shadow": {
    "note": "On a warm near-black background a drop shadow is almost invisible, so dark-mode elevation is carried by the surface stack plus a 1px top hairline. Light-mode shadows use lower alpha and more spread because the same alpha reads roughly twice as heavy on white.",
    "dark": {
      "none": "none",
      "sm": "0 1px 2px rgba(0, 0, 0, 0.40)",
      "md": "0 2px 4px -1px rgba(0, 0, 0, 0.45), 0 4px 12px -2px rgba(0, 0, 0, 0.34)",
      "lg": "0 8px 24px -6px rgba(0, 0, 0, 0.50), 0 2px 6px -2px rgba(0, 0, 0, 0.40)",
      "xl": "0 24px 60px -12px rgba(0, 0, 0, 0.58), 0 4px 12px -4px rgba(0, 0, 0, 0.44)",
      "hairline": "inset 0 1px 0 rgba(248, 245, 241, 0.06)"
    },
    "light": {
      "none": "none",
      "sm": "0 1px 2px rgba(37, 32, 25, 0.07)",
      "md": "0 1px 2px rgba(37, 32, 25, 0.06), 0 4px 10px -2px rgba(37, 32, 25, 0.08)",
      "lg": "0 2px 4px -1px rgba(37, 32, 25, 0.06), 0 10px 28px -6px rgba(37, 32, 25, 0.12)",
      "xl": "0 4px 8px -2px rgba(37, 32, 25, 0.07), 0 28px 64px -12px rgba(37, 32, 25, 0.16)",
      "hairline": "inset 0 1px 0 rgba(255, 255, 255, 0.90)"
    },
    "focus": "0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-border-focus)",
    "focusInset": "inset 0 0 0 2px var(--color-border-focus)"
  },
  "blur": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "32px",
    "note": "Backdrop only. Never blur content the user is reading."
  },
  "motion": {
    "duration": {
      "0": "0ms",
      "1": "80ms",
      "2": "120ms",
      "3": "180ms",
      "4": "240ms",
      "5": "320ms",
      "6": "480ms",
      "7": "700ms"
    },
    "durationUse": {
      "1": "colour and opacity on hover - below this it looks broken",
      "2": "press, focus ring, checkbox",
      "3": "dropdown, tooltip, tab underline",
      "4": "popover, drawer, accordion",
      "5": "modal, page-level transition",
      "6": "the longest thing allowed on screen",
      "7": "streamed-output typewriter reveal only"
    },
    "easing": {
      "linear": {
        "curve": "linear",
        "use": "determinate progress only"
      },
      "enter": {
        "curve": "cubic-bezier(0.22, 1, 0.36, 1)",
        "use": "arrivals: fast in, long settle"
      },
      "exit": {
        "curve": "cubic-bezier(0.64, 0, 0.78, 0)",
        "use": "departures: slow start, snatched away"
      },
      "move": {
        "curve": "cubic-bezier(0.32, 0.08, 0.24, 1)",
        "use": "position or size changes on something already visible"
      },
      "toggle": {
        "curve": "cubic-bezier(0.20, 0.90, 0.30, 1.15)",
        "use": "15% overshoot. Switches and checkboxes only."
      },
      "cut": {
        "curve": "cubic-bezier(0.90, 0.00, 1.00, 1)",
        "use": "dismissals: accelerate off-screen, no settle"
      }
    },
    "banned": "ease-in-out. It is symmetric, which is exactly wrong for interface motion - things should leave faster than they arrive."
  },
  "zIndex": {
    "below": -1,
    "base": 0,
    "raised": 10,
    "sticky": 100,
    "header": 200,
    "dropdown": 300,
    "overlay": 400,
    "modal": 500,
    "popover": 600,
    "toast": 700,
    "tooltip": 800,
    "max": 9999
  },
  "layout": {
    "container": {
      "xs": "30rem",
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "75rem",
      "2xl": "90rem",
      "prose": "68ch",
      "code": "92ch"
    },
    "gutter": {
      "inline": "1.25rem",
      "inlineWide": "2rem"
    },
    "grid": {
      "columns": 12,
      "gap": "1.5rem"
    },
    "control": {
      "heightSm": "1.75rem",
      "heightMd": "2.25rem",
      "heightLg": "2.75rem",
      "targetMin": "1.5rem",
      "targetComfortable": "2.75rem",
      "note": "WCAG 2.2 AA (2.5.8) sets a 24x24 CSS px floor. 44px is the default for anything a thumb will hit."
    },
    "breakpoints": {
      "sm": {
        "rem": "40rem",
        "px": 640
      },
      "md": {
        "rem": "48rem",
        "px": 768
      },
      "lg": {
        "rem": "64rem",
        "px": 1024
      },
      "xl": {
        "rem": "80rem",
        "px": 1280
      },
      "2xl": {
        "rem": "96rem",
        "px": 1536
      },
      "note": "CSS custom properties cannot be used inside a media query condition. These exist so JS and documentation stay in sync with the literals hard-coded in stylesheets."
    }
  },
  "opacity": {
    "disabled": 0.45,
    "muted": 0.7,
    "scrim": 0.72
  },
  "contrast": {
    "method": "WCAG 2.x relative luminance computed on the exact sRGB hex values in this file. minimum is 4.5 for body text and 3 for large text and non-text UI (WCAG 1.4.3 and 1.4.11).",
