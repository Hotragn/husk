{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "husk",
  "version": "1.0.0",
  "description": "Husk design tokens. Dark is the primary theme. Every text/background and control/background pairing has a measured WCAG contrast ratio under `contrast`; all 96 checked pairings meet AA.",
  "license": "Apache-2.0",
  "meta": {
    "colorSpace": "Ramps authored in OKLCH for perceptually even steps, then gamut-clipped to sRGB. Output values are sRGB hex.",
    "hues": {
      "neutral": {
        "oklchHue": 74,
        "name": "chaff",
        "note": "Warm grey. A cold grey next to husk gold reads as a rendering bug."
      },
      "primary": {
        "oklchHue": 72,
        "name": "husk gold",
        "note": "The dry outer layer. Chroma capped at 0.118 so it reads as dried husk, not neon amber."
      },
      "accent": {
        "oklchHue": 194,
        "name": "core teal",
        "note": "The cold electric inner core. Chroma pushed to the sRGB gamut boundary at steps 300-500."
      }
    },
    "contrastMethod": "WCAG 2.x relative luminance, computed on the exact sRGB hex values in this file. Body text floor 4.5:1; large text and non-text UI floor 3:1.",
    "themeStrategy": "Light is a separate tuning, not an inversion. The surface stack reverses direction, brand foregrounds move from the 300 step to the 700 step, and status hues change chroma as well as lightness. Brand fills stay at the 300 step in both themes."
  },
  "color": {
    "neutral": {
      "50": "#f8f5f1",
      "100": "#ede9e4",
      "200": "#dad5cf",
      "300": "#bdb8b1",
