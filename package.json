{
  "name": "husk-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Husk — give your agent a computer.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.10"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=@husk/core --workspace=@husk/runtime --workspace=@husk/models --workspace=@husk/sessions --workspace=@husk/agent --workspace=@husk/browser --workspace=@husk/adapters --workspace=@husk/mcp --workspace=@husk/server --workspace=@husk/sdk --workspace=@husk/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "husk": "node packages/cli/dist/bin.js",
    "dev:web": "npm run dev --workspace=@husk/web",
    "dev:console": "npm run dev --workspace=@husk/console"
  },
  "devDependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "fastify": "^5.12.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  }
}
